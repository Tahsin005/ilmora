  "resource": {
    "dua": {
      "title": "Today's Dua",
      "arabic": "اللَّهُمَّ اهْدِنِي فِيمَنْ هَدَيْتَ وَعَافِنِي فِيمَنْ عَافَيْتَ وَتَوَلَّنِي فِيمَنْ تَوَلَّيْتَ وَبَارِكْ لِي فِيمَا أَعْطَيْتَ وَقِنِي شَرَّ مَا قَضَيْتَ",
      "translation": "O Allah, guide me among those You have guided, grant me well-being among those You have granted well-being, take me into Your care among those You have taken into Your care, bless me in what You have given, and protect me from the evil of what You have decreed.",
      "transliteration": "Allahumma ihdini fiman hadayt wa 'afini fiman 'afayt wa tawallani fiman tawallayt wa barik li fima a'tayt wa qini sharra ma qadayt.",
      "reference": "Sunan an-Nasa'i 1745"
    },
    "hadith": {
      "arabic": "أَسَرَّ إِلَيَّ إِنَّ جِبْرِيلَ كَانَ يُعَارِضُنِي الْقُرْآنَ كُلَّ سَنَةٍ مَرَّةً وَإِنَّهُ عَارَضَنِي الْعَامَ مَرَّتَيْنِ وَلَا أُرَاهُ إِلَّا حَضَرَ أَجَلِي",
      "english": "Gabriel would come to me to revise the Quran once every year. This year he revised with me twice. I do not think it means anything but that my term will come to an end.",
      "source": "Ṣaḥīḥ al-Bukhārī 3623",
      "grade": "Muttafaqun Alayhi"
    }
  },
