  "resource": {
    "dua": {
      "title": "Today's Dua",
      "arabic": "اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنْ شَرِّ مَا عَمِلْتُ وَمِنْ شَرِّ مَا لَمْ أَعْمَلْ",
      "translation": "O Allah, I seek refuge in You from the evil of what I have done and from the evil of what I have not done.",
      "transliteration": "Allahumma inni a'udhu bika min sharri ma 'amiltu wa min sharri ma lam a'mal.",
      "reference": "Sahih Muslim 2716"
    },
    "hadith": {
      "arabic": "مَنْ قَامَ رَمَضَانَ إِيمَانًا وَاحْتِسَابًا غُفِرَ لَهُ مَا تَقَدَّمَ مِنْ ذَنْبِهِ",
      "english": "Whoever stands in prayer during Ramadan due to faith and seeking reward, his previous sins will be forgiven.",
      "source": "Ṣaḥīḥ al-Bukhārī 2009",
      "grade": "Muttafaqun Alayhi"
    }
