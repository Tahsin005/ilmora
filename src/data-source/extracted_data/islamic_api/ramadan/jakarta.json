  "resource": {
    "dua": {
      "title": "Today's Dua",
      "arabic": "رَبَّنَا إِنَّنَا آمَنَّا فَاغْفِرْ لَنَا ذُنُوبَنَا وَقِنَا عَذَابَ النَّارِ",
      "translation": "Our Lord, indeed we have believed, so forgive us our sins and protect us from the punishment of the Fire.",
      "transliteration": "Rabbana innana amanna faghfir lana dhunubana wa qina 'adhab an-nar.",
      "reference": "Qur’an 3:16"
    },
    "hadith": {
      "arabic": "الصَّلَوَاتُ الْخَمْسُ وَالْجُمُعَةُ إِلَى الْجُمُعَةِ وَرَمَضَانُ إِلَى رَمَضَانَ مُكَفِّرَاتٌ مَا بَيْنَهُنَّ مَا اجْتُنِبَتْ الْكَبَائِرُ",
      "english": "The five prayers, Friday to Friday, and Ramadan to Ramadan will be expiation for the sins between them, so long as major sins are avoided.",
      "source": "Ṣaḥīḥ Muslim 233",
      "grade": "Sahih"
    }
  },
