  "resource": {
    "dua": {
      "title": "Today's Dua",
      "arabic": "ذَهَبَ الظَّمَأُ وَابْتَلَّتِ الْعُرُوقُ وَثَبَتَ الْأَجْرُ إِنْ شَاءَ اللَّهُ",
      "translation": "The thirst has gone, the veins are moistened, and the reward is confirmed, if Allah wills.",
      "transliteration": "Dhahaba az-zama'u wabtallat al-'uruq wa thabata al-ajr in sha Allah.",
      "reference": "Sunan Abi Dawud 2357"
    },
    "hadith": {
      "arabic": "كَانَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَجْتَهِدُ فِي الْعَشْرِ الْأَوَاخِرِ مَا لَا يَجْتَهِدُ فِي غَيْرِهِ",
      "english": "The Prophet, peace and blessings be upon him, would exert himself in worship during the last ten nights of Ramadan more so than any other time.",
      "source": "Ṣaḥīḥ Muslim 1175",
      "grade": "Sahih"
    }
