    "dua": {
      "title": "Today's Dua",
      "arabic": "رَبَّنَا تَقَبَّلْ مِنَّا إِنَّكَ أَنتَ السَّمِيعُ الْعَلِيمُ",
      "translation": "Our Lord, accept from us. Indeed, You are the All-Hearing, the All-Knowing.",
      "transliteration": "Rabbana taqabbal minna innaka anta as-Sami'u al-'Alim.",
      "reference": "Qur’an 2:127"
    },
    "hadith": {
      "arabic": "وَرَغِمَ أَنْفُ رَجُلٍ دَخَلَ عَلَيْهِ رَمَضَانُ ثُمَّ انْسَلَخَ قَبْلَ أَنْ يُغْفَرَ لَهُ",
      "english": "May he be humbled, who enters the month of Ramadan and it passes before he is forgiven.",
      "source": "Sunan al-Tirmidhī 3545",
      "grade": "Sahih"
    }
