  "resource": {
    "dua": {
      "title": "Today's Dua",
      "arabic": "اللَّهُمَّ اغْفِرْ لِي وَارْحَمْنِي وَعَافِنِي وَارْزُقْنِي",
      "translation": "O Allah, forgive me, have mercy upon me, grant me well-being, and provide for me.",
      "transliteration": "Allahumma ighfir li warhamni wa 'afini warzuqni.",
      "reference": "Sunan Abi Dawud 850"
    },
    "hadith": {
      "arabic": "مَنْ نَسِيَ وَهُوَ صَائِمٌ فَأَكَلَ أَوْ شَرِبَ فَلْيُتِمَّ صَوْمَهُ فَإِنَّمَا أَطْعَمَهُ اللَّهُ وَسَقَاهُ",
      "english": "Whoever eats or drinks forgetfully while he is fasting, let him complete his fast, for Allah has fed him and given him drink.",
      "source": "Ṣaḥīḥ al-Bukhārī 1933",
      "grade": "Muttafaqun Alayhi"
    }
