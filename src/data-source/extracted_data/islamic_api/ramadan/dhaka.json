  "resource": {
    "dua": {
      "title": "Today's Dua",
      "arabic": "ذَهَبَ الظَّمَأُ وَابْتَلَّتِ الْعُرُوقُ وَثَبَتَ الْأَجْرُ إِنْ شَاءَ اللَّهُ",
      "translation": "The thirst has gone, the veins are moistened, and the reward is confirmed, if Allah wills.",
      "transliteration": "Dhahaba az-zama'u wabtallat al-'uruq wa thabata al-ajr in sha Allah.",
      "reference": "Sunan Abi Dawud 2357"
    },
    "hadith": {
      "arabic": "إِنَّهُ مَنْ قَامَ مَعَ الإِمَامِ يعنى في رمضان حَتَّى يَنْصَرِفَ كُتِبَ لَهُ قِيَامُ لَيْلَةٍ",
      "english": "Verily, whoever stands for prayer in Ramadan with the Imam until he is finished, it will be recorded as if he prayed the entire night.",
      "source": "Sunan al-Tirmidhī 806",
      "grade": "Sahih"
    }
